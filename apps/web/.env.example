# =================================
# Landing Hub Web App Configuration
# =================================

# API Configuration
# IMPORTANT: Frontend (port 3000) calls Backend (port 5000)
REACT_APP_API_URL=http://localhost:5000

# Environment
REACT_APP_ENV=development

# =================================
# AI Configuration (Builder Features)
# =================================
# Note: AI is now handled by BACKEND using Groq/Gemini
# Configure GROQ_API_KEY and GEMINI_API_KEY in backend/.env

# Legacy OpenAI support (optional, for backward compatibility)
# REACT_APP_OPENAI_API_KEY=sk-your-key-here
# REACT_APP_AI_API_URL=https://api.openai.com/v1

# =================================
# Google OAuth (optional)
# =================================
# REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id

# =================================
# Feature Flags
# =================================
REACT_APP_ENABLE_AI_FEATURES=true
REACT_APP_ENABLE_CHATBOX=true
