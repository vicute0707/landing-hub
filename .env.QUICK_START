# ================================================
# 🚀 LANDING HUB - QUICK START .ENV
# Copy to backend/.env and fill in your values
# ================================================

# -----------------
# DATABASE (Required)
# -----------------
MONGO_URI=mongodb://localhost:27017/landinghub

# -----------------
# SERVER (Required)
# -----------------
PORT=5000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change_this_to_random_string_in_production

# -----------------
# AI - GROQ (Required - Miễn phí)
# Get key: https://console.groq.com/
# -----------------
GROQ_API_KEY=gsk_paste_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------
# AI - GEMINI (Required - Miễn phí, Fallback)
# Get key: https://aistudio.google.com/app/apikey
# -----------------
GEMINI_API_KEY=paste_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# -----------------
# EMAIL (Optional - Cho notifications)
# -----------------
# Hướng dẫn Gmail:
# 1. Bật 2-Step Verification: https://myaccount.google.com/security
# 2. Tạo App Password: https://myaccount.google.com/apppasswords
# 3. Copy 16 ký tự app password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Admin email nhận thông báo chat mới
ADMIN_EMAIL=admin@yourdomain.com

# -----------------
# AWS S3 (Optional - Cho upload files trong chat)
# -----------------
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=landinghub-uploads

# -----------------
# VNPAY (Optional - Thanh toán VN)
# -----------------
VNPAY_TMN_CODE=your_vnpay_code
VNPAY_HASH_SECRET=your_vnpay_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/callback

# -----------------
# FEATURE FLAGS
# -----------------
ENABLE_AI_CHAT=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_ADMIN_REPORTS=true

# ================================================
# 📝 SETUP STEPS:
# ================================================
# 1. Copy file này:
#    cp .env.QUICK_START backend/.env
#
# 2. Lấy Groq API key (MIỄN PHÍ):
#    https://console.groq.com/ → API Keys → Create
#
# 3. Lấy Gemini API key (MIỄN PHÍ):
#    https://aistudio.google.com/app/apikey
#
# 4. (Tùy chọn) Setup Gmail cho email:
#    - Bật 2FA
#    - Tạo App Password
#    - Copy vào SMTP_PASSWORD
#
# 5. Khởi động:
#    cd backend && npm run dev
#
# ================================================
